OJ_DATABASE_PATH=data/oj.db
OJ_PROBLEMS_DIR=problems
OJ_RUNTIME_DIR=runtime
OJ_SESSION_COOKIE_NAME=oj_session
OJ_SESSION_TTL_SECONDS=86400
OJ_SESSION_COOKIE_SECURE=false
OJ_DEFAULT_TIME_LIMIT=3
OJ_DEFAULT_MEMORY_LIMIT=128
OJ_COMPILE_TIME_LIMIT=15
OJ_MAX_PROGRAM_OUTPUT_BYTES=1048576
OJ_LOG_LEVEL=INFO

# Required by the assignment. Override only in a private local environment.
OJ_INITIAL_ADMIN_USERNAME=admin
OJ_INITIAL_ADMIN_PASSWORD=admintestpassword
