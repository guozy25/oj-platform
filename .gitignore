# Tests, linters, type checkers and coverage
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Packaging and build output
build/
dist/
*.egg-info/
pip-wheel-metadata/

# Logs
*.log

# Runtime state
data/*
!data/.gitkeep
runtime/
problems/*
